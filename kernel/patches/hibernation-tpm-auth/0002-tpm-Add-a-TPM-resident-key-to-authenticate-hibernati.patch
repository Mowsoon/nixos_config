 }

+#ifdef CONFIG_TCG_TPM2_HIBERNATION
+bool tpm2_hibernation_supported(void);
+int tpm2_hibernation_mac(const u8 *digest, u8 *mac);
+#else
+static inline bool tpm2_hibernation_supported(void)
+{
+	return false;
+}
+
+static inline int tpm2_hibernation_mac(const u8 *digest, u8 *mac)
+{
+	return -ENODEV;
+}
+#endif
+
 static inline u32 tpm2_rc_value(u32 rc)
 {
 	return (rc & BIT(7)) ? rc & 0xbf : rc;
