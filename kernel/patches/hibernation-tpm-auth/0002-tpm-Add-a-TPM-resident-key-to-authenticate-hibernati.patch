index 000000000..5c9456c8b
--- /dev/null
+++ b/drivers/char/tpm/tpm2-hibernation.c
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * A TPM-resident key that authenticates hibernation images.
+ *
+ * The key is a keyed-hash primary object of the owner hierarchy.  Its
+ * authorization policy is PolicyPCR on PCR 23 at the value that a reset
+ * followed by one extend with a fixed label gives.  CONFIG_TCG_TPM_RESTRICT_PCR
+ * keeps user space and the other kernel users of the TPM from resetting or
+ * extending PCR 23, so only this file can bring PCR 23 to that value, and it
+ * moves PCR 23 away from it before returning.  The key never leaves the TPM
+ * and nothing is stored: the template derives the same key at every boot
+ * until the owner hierarchy is cleared.
+ */
+
+#include <crypto/sha2.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/tpm.h>
+#include <linux/unaligned.h>
+
+#include "tpm.h"
+
+#define TPM2_HIB_OPEN_LABEL	"linux-hibernation-auth-open-v1"
+#define TPM2_HIB_CLOSE_LABEL	"linux-hibernation-auth-close-v1"
+
+#define TPM2_HIB_KEY_ATTRS	(TPM2_OA_FIXED_TPM | TPM2_OA_FIXED_PARENT | \
+				 TPM2_OA_SENSITIVE_DATA_ORIGIN | \
+				 TPM2_OA_ADMIN_WITH_POLICY | TPM2_OA_NO_DA | \
+				 TPM2_OA_SIGN)
+
+/*
+ * TPMT_PUBLIC of the key: type, name algorithm, attributes, the policy as a
+ * sized SHA-256 digest, the HMAC scheme and its hash, and an empty unique.
+ */
+#define TPM2_HIB_TEMPLATE_SIZE	(2 + 2 + 4 + 2 + SHA256_DIGEST_SIZE + 2 + 2 + 2)
+
+/* TPML_PCR_SELECTION of PCR 23 in the SHA-256 bank */
+#define TPM2_HIB_SELECTION_SIZE	(4 + 2 + 1 + TPM2_PCR_SELECT_MIN)
+
+#define TPM2_HIB_NONCE_SIZE	SHA256_DIGEST_SIZE
+
+static void tpm2_hib_selection(u8 *sel)
+{
+	put_unaligned_be32(1, &sel[0]);
+	put_unaligned_be16(TPM_ALG_SHA256, &sel[4]);
+	sel[6] = TPM2_PCR_SELECT_MIN;
+	memset(&sel[7], 0, TPM2_PCR_SELECT_MIN);
+	sel[7 + TPM_RESTRICTED_PCR / 8] = BIT(TPM_RESTRICTED_PCR % 8);
+}
+
+static void tpm2_hib_label(const char *label, u8 *digest)
+{
+	sha256(label, strlen(label), digest);
+}
+
+/*
+ * The authorization policy of the key, as TPM2_PolicyPCR computes it:
+ * SHA-256 of the initial zero digest, the command code, the PCR selection and
+ * the SHA-256 of the selected PCR value.  That value is the extend of a reset
+ * PCR, all zeros, by the digest of the opening label.
+ */
+static void tpm2_hib_policy(u8 *policy)
+{
+	static const u8 zero[SHA256_DIGEST_SIZE];
+	u8 selection[TPM2_HIB_SELECTION_SIZE];
+	u8 digest[SHA256_DIGEST_SIZE];
+	__be32 cc = cpu_to_be32(TPM2_CC_POLICY_PCR);
+	struct sha256_ctx ctx;
+
+	tpm2_hib_label(TPM2_HIB_OPEN_LABEL, digest);
+	sha256_init(&ctx);
+	sha256_update(&ctx, zero, sizeof(zero));
+	sha256_update(&ctx, digest, sizeof(digest));
+	sha256_final(&ctx, digest);
+	sha256(digest, sizeof(digest), digest);
+
+	tpm2_hib_selection(selection);
+	sha256_init(&ctx);
+	sha256_update(&ctx, zero, sizeof(zero));
+	sha256_update(&ctx, (const u8 *)&cc, sizeof(cc));
+	sha256_update(&ctx, selection, sizeof(selection));
+	sha256_update(&ctx, digest, sizeof(digest));
+	sha256_final(&ctx, policy);
+}
+
+static int tpm2_hib_transmit(struct tpm_chip *chip, struct tpm_buf *buf,
+			     const char *desc)
+{
+	return tpm_ret_to_err(tpm_transmit_cmd(chip, buf, 0, desc));
+}
+
+static int tpm2_hib_pcr_reset(struct tpm_chip *chip, struct tpm_buf *buf)
+{
+	tpm_buf_reset(buf, TPM2_ST_SESSIONS, TPM2_CC_PCR_RESET);
+	tpm_buf_append_handle(chip, buf, TPM_RESTRICTED_PCR);
+	tpm_buf_append_empty_auth(buf, TPM2_RS_PW);
+
+	return tpm2_hib_transmit(chip, buf, "resetting the restricted PCR");
+}
+
+static int tpm2_hib_pcr_extend(struct tpm_chip *chip, struct tpm_buf *buf,
+			       const char *label)
+{
+	u8 digest[SHA256_DIGEST_SIZE];
+
+	tpm2_hib_label(label, digest);
+	tpm_buf_reset(buf, TPM2_ST_SESSIONS, TPM2_CC_PCR_EXTEND);
+	tpm_buf_append_handle(chip, buf, TPM_RESTRICTED_PCR);
+	tpm_buf_append_empty_auth(buf, TPM2_RS_PW);
+	tpm_buf_append_u32(buf, 1);
+	tpm_buf_append_u16(buf, TPM_ALG_SHA256);
+	tpm_buf_append(buf, digest, sizeof(digest));
+
+	return tpm2_hib_transmit(chip, buf, "extending the restricted PCR");
+}
+
+static int tpm2_hib_create_key(struct tpm_chip *chip, struct tpm_buf *buf,
+			       u32 *key)
+{
+	u8 policy[SHA256_DIGEST_SIZE];
+	off_t offset = TPM_HEADER_SIZE;
+	int rc;
+
+	tpm2_hib_policy(policy);
+	tpm_buf_reset(buf, TPM2_ST_SESSIONS, TPM2_CC_CREATE_PRIMARY);
+	tpm_buf_append_handle(chip, buf, TPM2_RH_OWNER);
+	tpm_buf_append_empty_auth(buf, TPM2_RS_PW);
+
+	/* sensitive part: empty authorization, key generated by the TPM */
+	tpm_buf_append_u16(buf, 4);
+	tpm_buf_append_u16(buf, 0);
+	tpm_buf_append_u16(buf, 0);
+
+	tpm_buf_append_u16(buf, TPM2_HIB_TEMPLATE_SIZE);
+	tpm_buf_append_u16(buf, TPM_ALG_KEYEDHASH);
+	tpm_buf_append_u16(buf, TPM_ALG_SHA256);
+	tpm_buf_append_u32(buf, TPM2_HIB_KEY_ATTRS);
+	tpm_buf_append_u16(buf, sizeof(policy));
+	tpm_buf_append(buf, policy, sizeof(policy));
+	tpm_buf_append_u16(buf, TPM_ALG_HMAC);
+	tpm_buf_append_u16(buf, TPM_ALG_SHA256);
+	tpm_buf_append_u16(buf, 0);
+
+	/* no outside information, no creation PCR */
+	tpm_buf_append_u16(buf, 0);
+	tpm_buf_append_u32(buf, 0);
+
+	rc = tpm2_hib_transmit(chip, buf, "creating the hibernation key");
+	if (rc)
+		return rc;
+
+	*key = tpm_buf_read_u32(buf, &offset);
+	return buf->flags & TPM_BUF_BOUNDARY_ERROR ? -EIO : 0;
+}
+
+static int tpm2_hib_start_session(struct tpm_chip *chip, struct tpm_buf *buf,
+				  u32 *session)
+{
+	u8 nonce[TPM2_HIB_NONCE_SIZE];
+	off_t offset = TPM_HEADER_SIZE;
+	int rc;
+
+	get_random_bytes(nonce, sizeof(nonce));
+	tpm_buf_reset(buf, TPM2_ST_NO_SESSIONS, TPM2_CC_START_AUTH_SESS);
+	tpm_buf_append_handle(chip, buf, TPM2_RH_NULL);
+	tpm_buf_append_handle(chip, buf, TPM2_RH_NULL);
+	tpm_buf_append_u16(buf, sizeof(nonce));
+	tpm_buf_append(buf, nonce, sizeof(nonce));
+	tpm_buf_append_u16(buf, 0);
+	tpm_buf_append_u8(buf, 0x01 /* POLICY */);
+	tpm_buf_append_u16(buf, TPM_ALG_NULL);
+	tpm_buf_append_u16(buf, TPM_ALG_SHA256);
+
+	rc = tpm2_hib_transmit(chip, buf, "starting the hibernation policy");
+	if (rc)
+		return rc;
+
+	*session = tpm_buf_read_u32(buf, &offset);
+	return buf->flags & TPM_BUF_BOUNDARY_ERROR ? -EIO : 0;
+}
+
+/* Bind the session to the current value of PCR 23. */
+static int tpm2_hib_policy_pcr(struct tpm_chip *chip, struct tpm_buf *buf,
+			       u32 session)
+{
+	u8 selection[TPM2_HIB_SELECTION_SIZE];
+
+	tpm2_hib_selection(selection);
+	tpm_buf_reset(buf, TPM2_ST_NO_SESSIONS, TPM2_CC_POLICY_PCR);
+	tpm_buf_append_handle(chip, buf, session);
+	tpm_buf_append_u16(buf, 0);
+	tpm_buf_append(buf, selection, sizeof(selection));
+
+	return tpm2_hib_transmit(chip, buf, "binding the hibernation policy");
+}
+
+/*
+ * The session is not continued: the TPM flushes it when the command
+ * succeeds.
+ */
+static int tpm2_hib_hmac(struct tpm_chip *chip, struct tpm_buf *buf,
+			 u32 key, u32 session, const u8 *digest, u8 *mac)
+{
+	u8 nonce[TPM2_HIB_NONCE_SIZE];
+	off_t offset = TPM_HEADER_SIZE + sizeof(u32);
+	int rc;
+
+	get_random_bytes(nonce, sizeof(nonce));
+	tpm_buf_reset(buf, TPM2_ST_SESSIONS, TPM2_CC_HMAC);
+	tpm_buf_append_handle(chip, buf, key);
+	tpm_buf_append_u32(buf, 4 + 2 + sizeof(nonce) + 1 + 2);
+	tpm_buf_append_u32(buf, session);
+	tpm_buf_append_u16(buf, sizeof(nonce));
+	tpm_buf_append(buf, nonce, sizeof(nonce));
+	tpm_buf_append_u8(buf, 0);
+	tpm_buf_append_u16(buf, 0);
+	tpm_buf_append_u16(buf, SHA256_DIGEST_SIZE);
+	tpm_buf_append(buf, digest, SHA256_DIGEST_SIZE);
+	tpm_buf_append_u16(buf, TPM_ALG_SHA256);
+
+	rc = tpm2_hib_transmit(chip, buf, "computing the hibernation MAC");
+	if (rc)
+		return rc;
+
+	if (tpm_buf_read_u16(buf, &offset) != SHA256_DIGEST_SIZE ||
+	    offset + SHA256_DIGEST_SIZE > tpm_buf_length(buf) ||
+	    buf->flags & TPM_BUF_BOUNDARY_ERROR)
+		return -EIO;
+
+	memcpy(mac, &buf->data[offset], SHA256_DIGEST_SIZE);
+	return 0;
+}
+
+static int tpm2_hib_authorize_and_mac(struct tpm_chip *chip,
+				      struct tpm_buf *buf, u32 key,
+				      const u8 *digest, u8 *mac)
+{
+	u32 session;
+	int rc;
+
+	rc = tpm2_hib_start_session(chip, buf, &session);
+	if (rc)
+		return rc;
+
+	rc = tpm2_hib_policy_pcr(chip, buf, session);
+	if (!rc)
+		rc = tpm2_hib_hmac(chip, buf, key, session, digest, mac);
+	if (rc)
+		tpm2_flush_context(chip, session);
+
+	return rc;
+}
+
+static int tpm2_hib_open(struct tpm_chip *chip, struct tpm_buf *buf)
+{
+	int rc;
+
+	rc = tpm2_hib_pcr_reset(chip, buf);
+	if (rc)
+		return rc;
+
+	return tpm2_hib_pcr_extend(chip, buf, TPM2_HIB_OPEN_LABEL);
+}
+
+/*
+ * Move PCR 23 away from the value that authorizes the key.  If the TPM
+ * refuses both the extend and the reset, the key may stay usable once user
+ * space runs again, so the TPM is not used any more until the next boot.
+ */
+static void tpm2_hib_close(struct tpm_chip *chip, struct tpm_buf *buf)
+{
+	if (!tpm2_hib_pcr_extend(chip, buf, TPM2_HIB_CLOSE_LABEL))
+		return;
+
+	if (!tpm2_hib_pcr_reset(chip, buf))
+		return;
+
+	dev_crit(&chip->dev, "PCR %d stays open, disabling the TPM\n",
+		 TPM_RESTRICTED_PCR);
+	chip->flags |= TPM_CHIP_FLAG_DISABLE;
+}
+
+static bool tpm2_hib_chip_supported(struct tpm_chip *chip)
+{
+	int i;
+
+	if (!(chip->flags & TPM_CHIP_FLAG_TPM2) ||
+	    chip->flags & (TPM_CHIP_FLAG_VIRTUAL | TPM_CHIP_FLAG_DISABLE))
+		return false;
+
+	for (i = 0; i < chip->nr_allocated_banks; i++)
+		if (chip->allocated_banks[i].alg_id == TPM_ALG_SHA256)
+			return true;
+
+	return false;
+}
+
+/**
+ * tpm2_hibernation_supported() - check for a TPM that can authenticate images
+ *
+ * Return: true when the default TPM is a TPM 2.0 that is not emulated by user
+ * space and has a SHA-256 PCR bank.
+ */
+bool tpm2_hibernation_supported(void)
+{
+	struct tpm_chip *chip = tpm_default_chip();
+	bool supported;
+
+	if (!chip)
+		return false;
+
+	supported = tpm2_hib_chip_supported(chip);
+	put_device(&chip->dev);
+
+	return supported;
+}
+
+/**
+ * tpm2_hibernation_mac() - authenticate a hibernation image digest
+ * @digest:	SHA-256 digest to authenticate
+ * @mac:	HMAC-SHA256 of @digest under the hibernation key
+ *
+ * Opens PCR 23, has the TPM compute the HMAC with the hibernation key, and
+ * closes PCR 23 again, all while holding the TPM.  The caller must make sure
+ * that no user space task runs meanwhile: the image is written or read with
+ * tasks frozen.
+ *
+ * Return: 0 on success, a negative error code otherwise.
+ */
+int tpm2_hibernation_mac(const u8 *digest, u8 *mac)
+{
+	struct tpm_chip *chip = tpm_default_chip();
+	struct tpm_buf storage;
+	struct tpm_buf *buf = &storage;
+	u32 key;
+	int rc;
+
+	if (!chip)
+		return -ENODEV;
+
+	rc = -ENODEV;
+	if (!tpm2_hib_chip_supported(chip))
+		goto out_put;
+
+	rc = tpm_buf_init(buf, TPM2_ST_NO_SESSIONS, 0);
+	if (rc)
+		goto out_put;
+
+	rc = tpm_try_get_ops(chip);
+	if (rc)
+		goto out_free;
+
+	rc = tpm2_hib_create_key(chip, buf, &key);
+	if (rc)
+		goto out_ops;
+
+	rc = tpm2_hib_open(chip, buf);
+	if (!rc)
+		rc = tpm2_hib_authorize_and_mac(chip, buf, key, digest, mac);
+	tpm2_hib_close(chip, buf);
+	tpm2_flush_context(chip, key);
+
+out_ops:
+	tpm_put_ops(chip);
+out_free:
+	tpm_buf_destroy(buf);
+out_put:
+	put_device(&chip->dev);
+	return rc;
+}
