Subject: [PATCH 4/4] PM: hibernate: Authenticate swap images with the TPM

Kernel lockdown disables hibernation: the image is written by one
kernel and read back by another through a swap device that root can
write, so root could have the boot kernel restore an image of its own
making and run code in the kernel. In integrity mode root can also read
kernel memory, so no key kept in kernel memory can protect the image.

Add CONFIG_HIBERNATION_TPM_AUTH. With it, the kernel hashes the image
stream as it writes it, and the TPM computes an HMAC of that digest,
of the header flags and of the hardware signature, under the key of
tpm2_hibernation_mac(), which only the kernel can use and only while
tasks are frozen. The HMAC goes into the swap header. The boot kernel
hashes the stream as it loads it, has the TPM compute the HMAC again,
and refuses to restore the image when the two differ. swsusp_check()
has already put the swap signature back by then, so a refused image is
not tried again and the boot goes on. An image that cannot be
authenticated is never written: hibernation fails instead.

Hibernation to swap is then allowed under lockdown, and requires a
TPM that tpm2_hibernation_supported() accepts, with or without
lockdown. The userspace snapshot device does not authenticate images,
so it stays disabled under lockdown.

What this does not cover:
- an earlier image of the same machine, authenticated by the same key,
  can be written back and restored once; it is a state that the kernel
  produced itself;
- a boot of a kernel that is not locked down, or that root can sign,
  can authenticate any image, as it can do anything else;
- the header, the swap map and the compressed data are parsed before
  the image is authenticated; image pages only go to memory that the
  boot kernel does not use.

---
 kernel/power/Kconfig     | 21 +++++++++++
 kernel/power/hibernate.c | 15 +++++++-
 kernel/power/swap.c      | 77 ++++++++++++++++++++++++++++++++++++++--
 kernel/power/user.c      |  5 ++-
 4 files changed, 113 insertions(+), 5 deletions(-)

diff --git a/kernel/power/Kconfig b/kernel/power/Kconfig
index ab8b807c2..c5dc0907f 100644
--- a/kernel/power/Kconfig
+++ b/kernel/power/Kconfig
@@ -93,6 +93,27 @@ config HIBERNATION_SNAPSHOT_DEV

 	  If in doubt, say Y.

+config HIBERNATION_TPM_AUTH
+	bool "Authenticate hibernation images with the TPM"
+	depends on HIBERNATION && TCG_TPM = y
+	select TCG_TPM2_HIBERNATION
+	select HIBERNATION_IMAGE_DIGEST
+	select CRYPTO_LIB_UTILS
+	help
+	  Authenticate every hibernation image written to swap with an
+	  HMAC that the TPM computes under a key only the kernel can use,
+	  and refuse to restore an image whose HMAC does not match.
+	  Hibernation then needs a TPM 2.0 with a SHA-256 PCR bank, and is
+	  unavailable without one.
+
+	  Kernel lockdown otherwise disables hibernation, since the image
+	  goes through a swap device that root can write.  With this
+	  option, hibernation to swap stays available under lockdown.  The
+	  userspace snapshot device does not authenticate images and stays
+	  disabled under lockdown.
+
+	  If unsure, say N.
+
 config HIBERNATION_IMAGE_DIGEST
 	bool
 	depends on HIBERNATION
diff --git a/kernel/power/hibernate.c b/kernel/power/hibernate.c
index c13f68ab7..a664fbcff 100644
--- a/kernel/power/hibernate.c
+++ b/kernel/power/hibernate.c
@@ -32,6 +32,7 @@
 #include <linux/ctype.h>
 #include <linux/ktime.h>
 #include <linux/security.h>
+#include <linux/tpm.h>
 #include <linux/secretmem.h>
 #include <trace/events/power.h>

@@ -106,10 +107,22 @@ bool hibernation_in_progress(void)
 	return !atomic_read(&hibernate_atomic);
 }

+/*
+ * An image authenticated by the TPM can be restored under lockdown, but
+ * an image that cannot be authenticated is never written.
+ */
+static bool hibernation_permitted(void)
+{
+	if (IS_ENABLED(CONFIG_HIBERNATION_TPM_AUTH))
+		return tpm2_hibernation_supported();
+
+	return !security_locked_down(LOCKDOWN_HIBERNATION);
+}
+
 bool hibernation_available(void)
 {
 	return nohibernate == 0 &&
-		!security_locked_down(LOCKDOWN_HIBERNATION) &&
+		hibernation_permitted() &&
 		!secretmem_active() && !cxl_mem_active();
 }

diff --git a/kernel/power/swap.c b/kernel/power/swap.c
index c626e9dc3..8292a7030 100644
--- a/kernel/power/swap.c
+++ b/kernel/power/swap.c
@@ -30,6 +30,8 @@
 #include <linux/kthread.h>
 #include <linux/crc32.h>
 #include <linux/ktime.h>
+#include <linux/tpm.h>
+#include <crypto/utils.h>

 #include "power.h"

@@ -98,11 +100,13 @@ struct swap_map_handle {
 	unsigned int k;
 	unsigned long reqd_free_pages;
 	u32 crc32;
+	u8 digest[SHA256_DIGEST_SIZE];
 };

 struct swsusp_header {
 	char reserved[PAGE_SIZE - 20 - sizeof(sector_t) - sizeof(int) -
-	              sizeof(u32) - sizeof(u32)];
+		      sizeof(u32) - sizeof(u32) - SHA256_DIGEST_SIZE];
+	u8	tpm_mac[SHA256_DIGEST_SIZE];
 	u32	hw_sig;
 	u32	crc32;
 	sector_t image;
@@ -299,6 +303,66 @@ static int hib_wait_io(struct hib_bio_batch *hb)
  * Saving part
  */

+/*
+ * The TPM authenticates the digest of the image stream together with the
+ * header fields that tell the boot kernel how to read and restore it.
+ */
+static int swsusp_image_mac(const u8 *stream_digest, u8 *mac)
+{
+	u8 digest[SHA256_DIGEST_SIZE];
+	struct sha256_ctx ctx;
+	__le32 value;
+
+	sha256_init(&ctx);
+	sha256_update(&ctx, stream_digest, SHA256_DIGEST_SIZE);
+	value = cpu_to_le32(swsusp_header->flags);
+	sha256_update(&ctx, (const u8 *)&value, sizeof(value));
+	value = cpu_to_le32(swsusp_header->hw_sig);
+	sha256_update(&ctx, (const u8 *)&value, sizeof(value));
+	sha256_final(&ctx, digest);
+
+	return tpm2_hibernation_mac(digest, mac);
+}
+
+static int swsusp_header_authenticate(struct swap_map_handle *handle)
+{
+	int error;
+
+	if (!IS_ENABLED(CONFIG_HIBERNATION_TPM_AUTH))
+		return 0;
+
+	error = swsusp_image_mac(handle->digest, swsusp_header->tpm_mac);
+	if (error)
+		pr_err("Cannot authenticate the image: %d\n", error);
+
+	return error;
+}
+
+static int swsusp_image_verify(struct snapshot_handle *snapshot)
+{
+	u8 digest[SHA256_DIGEST_SIZE];
+	u8 mac[SHA256_DIGEST_SIZE];
+	int error;
+
+	if (!IS_ENABLED(CONFIG_HIBERNATION_TPM_AUTH))
+		return 0;
+
+	snapshot_image_digest(snapshot, digest);
+	error = swsusp_image_mac(digest, mac);
+	if (error) {
+		pr_err("Cannot check the image authentication: %d\n", error);
+		return error;
+	}
+
+	if (crypto_memneq(mac, swsusp_header->tpm_mac, sizeof(mac))) {
+		pr_err("Image authentication failed\n");
+		return -EKEYREJECTED;
+	}
+
+	pr_info("Image authenticated by the TPM\n");
+	return 0;
+}
+
 static int mark_swapfiles(struct swap_map_handle *handle, unsigned int flags)
 {
 	int error;
@@ -316,8 +380,11 @@ static int mark_swapfiles(struct swap_map_handle *handle, unsigned int flags)
 		swsusp_header->flags = flags;
 		if (flags & SF_CRC32_MODE)
 			swsusp_header->crc32 = handle->crc32;
-		error = hib_submit_io_sync(REQ_OP_WRITE | REQ_SYNC,
-				      swsusp_resume_block, swsusp_header);
+		error = swsusp_header_authenticate(handle);
+		if (!error)
+			error = hib_submit_io_sync(REQ_OP_WRITE | REQ_SYNC,
+						   swsusp_resume_block,
+						   swsusp_header);
 	} else {
 		pr_err("Swap header not found!\n");
 		error = -ENODEV;
@@ -969,6 +1036,8 @@ int swsusp_write(unsigned int flags)
 			save_image(&handle, &snapshot, pages - 1) :
 			save_compressed_image(&handle, &snapshot, pages - 1);
 	}
+	if (!error && IS_ENABLED(CONFIG_HIBERNATION_TPM_AUTH))
+		snapshot_image_digest(&snapshot, handle.digest);
 out_finish:
 	error = swap_writer_finish(&handle, flags, error);
 	return error;
@@ -1539,6 +1608,8 @@ int swsusp_read(unsigned int *flags_p)
 			load_image(&handle, &snapshot, header->pages - 1) :
 			load_compressed_image(&handle, &snapshot, header->pages - 1);
 	}
+	if (!error)
+		error = swsusp_image_verify(&snapshot);
 	swap_reader_finish(&handle);
 end:
 	if (!error)
diff --git a/kernel/power/user.c b/kernel/power/user.c
index d0fcfba7a..e7b3da07e 100644
--- a/kernel/power/user.c
+++ b/kernel/power/user.c
@@ -21,6 +21,7 @@
 #include <linux/console.h>
 #include <linux/cpu.h>
 #include <linux/freezer.h>
+#include <linux/security.h>

 #include <linux/uaccess.h>

@@ -50,7 +51,9 @@ static int snapshot_open(struct inode *inode, struct file *filp)
 	unsigned int sleep_flags;
 	int error;

-	if (!hibernation_available())
+	/* Images that go through user space are not authenticated. */
+	if (!hibernation_available() ||
+	    security_locked_down(LOCKDOWN_HIBERNATION))
 		return -EPERM;

 	sleep_flags = lock_system_sleep();
