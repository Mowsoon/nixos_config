Subject: [PATCH 3/4] PM: hibernate: Compute a SHA-256 digest of the image
 stream

Add CONFIG_HIBERNATION_IMAGE_DIGEST, selected by code that needs to
authenticate a hibernation image. With it, the snapshot handle keeps a
SHA-256 digest of the pages it exchanges with its caller, and
snapshot_image_digest() returns it.

The stream is the same in both directions: the header, the PFN pages,
then the data pages, zero pages excluded. When hibernating, a page is
added as snapshot_read_next() hands it out. When restoring, the caller
fills the page after snapshot_write_next() returns, so the page is
added at the next call; a flag keeps the last page from being added
twice, since the loaders call snapshot_write_next() once more after the
end of the image and snapshot_write_finalize() calls it again.

Hashing at this level covers the swap writer and loader, compressed or
not, without touching them.

---
 kernel/power/Kconfig    |  5 ++++
 kernel/power/power.h    |  8 ++++++
 kernel/power/snapshot.c | 61 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 74 insertions(+)

diff --git a/kernel/power/Kconfig b/kernel/power/Kconfig
index 530c89731..ab8b807c2 100644
--- a/kernel/power/Kconfig
+++ b/kernel/power/Kconfig
@@ -93,6 +93,11 @@ config HIBERNATION_SNAPSHOT_DEV

 	  If in doubt, say Y.

+config HIBERNATION_IMAGE_DIGEST
+	bool
+	depends on HIBERNATION
+	select CRYPTO_LIB_SHA256
+
 choice
 	prompt "Default compressor"
 	default HIBERNATION_COMP_LZO
diff --git a/kernel/power/power.h b/kernel/power/power.h
index 75b638438..e9e5d6c0a 100644
--- a/kernel/power/power.h
+++ b/kernel/power/power.h
@@ -7,6 +7,7 @@
 #include <linux/cpu.h>
 #include <linux/cpuidle.h>
 #include <linux/crypto.h>
+#include <crypto/sha2.h>

 struct swsusp_info {
 	struct new_utsname	uts;
@@ -150,6 +151,12 @@ struct snapshot_handle {
 					 * snapshot_write_next() that it may
 					 * need to call wait_on_bio_chain()
 					 */
+#ifdef CONFIG_HIBERNATION_IMAGE_DIGEST
+	struct sha256_ctx digest;	/* SHA-256 of the pages exchanged */
+	bool		digest_pending;	/* the caller fills a page that is not
+					 * in the digest yet
+					 */
+#endif
 };

 /* This macro returns the address from/to which the caller of
@@ -163,6 +170,7 @@ extern unsigned long snapshot_get_image_size(void);
 extern int snapshot_read_next(struct snapshot_handle *handle);
 extern int snapshot_write_next(struct snapshot_handle *handle);
 int snapshot_write_finalize(struct snapshot_handle *handle);
+void snapshot_image_digest(struct snapshot_handle *handle, u8 *digest);
 extern int snapshot_image_loaded(struct snapshot_handle *handle);

 extern bool hibernate_acquire(void);
diff --git a/kernel/power/snapshot.c b/kernel/power/snapshot.c
index 4a73927cc..a4e4a203c 100644
--- a/kernel/power/snapshot.c
+++ b/kernel/power/snapshot.c
@@ -2216,6 +2216,59 @@ static inline void pack_pfns(unsigned long *buf, struct memory_bitmap *bm,
 	}
 }

+#ifdef CONFIG_HIBERNATION_IMAGE_DIGEST
+/*
+ * The image digest covers the pages exchanged with the caller of
+ * snapshot_read_next() or snapshot_write_next(), in order: the header, the
+ * PFN pages and the data pages.  Zero pages are not part of the image, so
+ * they are not part of the digest either.  When hibernating, a page enters
+ * the digest as it is handed out; when restoring, at the next call, once
+ * the caller has filled it.
+ */
+static void snapshot_digest_init(struct snapshot_handle *handle)
+{
+	sha256_init(&handle->digest);
+	handle->digest_pending = false;
+}
+
+static void snapshot_digest_page(struct snapshot_handle *handle)
+{
+	sha256_update(&handle->digest, handle->buffer, PAGE_SIZE);
+}
+
+static void snapshot_digest_filled_page(struct snapshot_handle *handle)
+{
+	if (!handle->digest_pending)
+		return;
+
+	snapshot_digest_page(handle);
+	handle->digest_pending = false;
+}
+
+static void snapshot_digest_hand_out(struct snapshot_handle *handle)
+{
+	handle->digest_pending = true;
+}
+
+/**
+ * snapshot_image_digest - Get the SHA-256 digest of the image stream.
+ * @handle: Snapshot handle that read or wrote the whole image.
+ * @digest: Output buffer of SHA256_DIGEST_SIZE bytes.
+ *
+ * Call it once, after snapshot_read_next() returned 0 when hibernating, or
+ * after snapshot_write_finalize() when restoring.
+ */
+void snapshot_image_digest(struct snapshot_handle *handle, u8 *digest)
+{
+	sha256_final(&handle->digest, digest);
+}
+#else
+static inline void snapshot_digest_init(struct snapshot_handle *handle) {}
+static inline void snapshot_digest_page(struct snapshot_handle *handle) {}
+static inline void snapshot_digest_filled_page(struct snapshot_handle *handle) {}
+static inline void snapshot_digest_hand_out(struct snapshot_handle *handle) {}
+#endif
+
 /**
  * snapshot_read_next - Get the address to read the next image page from.
  * @handle: Snapshot handle to be used for the reading.
@@ -2246,6 +2299,7 @@ int snapshot_read_next(struct snapshot_handle *handle)
 	if (!handle->cur) {
 		int error;

+		snapshot_digest_init(handle);
 		error = init_header((struct swsusp_info *)buffer);
 		if (error)
 			return error;
@@ -2275,6 +2329,7 @@ int snapshot_read_next(struct snapshot_handle *handle)
 			handle->buffer = page_address(page);
 		}
 	}
+	snapshot_digest_page(handle);
 	handle->cur++;
 	return PAGE_SIZE;
 }
@@ -2771,6 +2826,11 @@ int snapshot_write_next(struct snapshot_handle *handle)
 	static struct chain_allocator ca;
 	int error;

+	if (!handle->cur)
+		snapshot_digest_init(handle);
+	else
+		snapshot_digest_filled_page(handle);
+
 next:
 	/* Check if we have already loaded the entire image */
 	if (handle->cur > 1 && handle->cur > nr_meta_pages + nr_copy_pages + nr_zero_pages)
@@ -2841,6 +2901,7 @@ int snapshot_write_next(struct snapshot_handle *handle)
 		goto next;
 	}

+	snapshot_digest_hand_out(handle);
 	return PAGE_SIZE;
 }

